# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Connection (RDS PostgreSQL)
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-custom-configs-bucket-name
LAMBDA_PROFILER_NAME=lambda-profiler
LAMBDA_CHECKER_NAME=lambda-checker
LAMBDA_AGENT_TRIGGER_NAME=lambda-orchestrator-trigger
NEXT_PUBLIC_TRIGGER_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/orchestrator

# Security & Multi-Tenancy
REQUIRE_AUTH=false
JWT_SECRET=your-secret-key-change-in-production
DEFAULT_TENANT_ID=default
