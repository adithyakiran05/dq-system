{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "dq-agent",
  "version": 1,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "dq_agent_runtime",
      "build": "Container",
      "entrypoint": "agent.py",
      "codeLocation": "./",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "GROQ_API_KEY",
          "value": "<YOUR_GROQ_API_KEY>"
        }
      ]
    }
  ]
}